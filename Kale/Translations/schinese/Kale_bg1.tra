@300106  = ~^R卡勒不赞同。^-~
@300109  = ~^R卡勒非常不赞同。^-~
@300113  = ~^G卡勒略微赞同^-~
@300116  = ~^G卡勒赞同^-~
@300119  = ~^G卡勒非常赞同^-~
@30099 = ~^0xFFFF00FF你与卡勒建立了深厚的羁绊。你们的默契提升了其能力。^-~
